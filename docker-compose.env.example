# ============================================================
# CodeCanvas — Docker Compose Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets to source control.
# ============================================================

# --- Secrets (REQUIRED in production) ----------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Strong password for the PostgreSQL container
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# --- Application -------------------------------------------
ENVIRONMENT=production   # development | test | production

# --- AI Assistant (optional) --------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
