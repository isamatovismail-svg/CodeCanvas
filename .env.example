# CodeCanvas Global Environment Configuration

# Backend Settings
PROJECT_NAME="CodeCanvas"
API_V1_STR="/api/v1"
SECRET_KEY="your-secure-random-secret-key-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local SQLite Async (default for instant run):
DATABASE_URL="sqlite+aiosqlite:///./codecanvas.db"
# Or Docker/Production PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://codecanvas:codecanvas_password@localhost:5438/codecanvas"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Assistant (Optional - structured engine active if not set)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Upload directory
UPLOAD_DIR="./uploads"
