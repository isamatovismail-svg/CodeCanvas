# CodeCanvas Configuration
PROJECT_NAME="CodeCanvas"
API_V1_STR="/api/v1"
SECRET_KEY="replace_this_secret_key_in_production_with_a_secure_random_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Default: SQLite async; For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/codecanvas)
DATABASE_URL="sqlite+aiosqlite:///./codecanvas.db"

# Redis Pub/Sub (For multi-instance realtime synchronization)
REDIS_URL="redis://localhost:6379/0"

# AI Assistant API Keys (Optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Uploads directory
UPLOAD_DIR="./uploads"
